<Window x:Class="WinWake.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WinWake" Height="200" Width="400"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Windows Awake Control"
                   FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Button Grid.Row="1"
                Command="{Binding ToggleKeepAwakeCommand}"
                FontSize="16" Padding="20,10"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MinWidth="200" MinHeight="50">
            <TextBlock x:Name="ButtonText">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Keep Awake: OFF"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeepAwakeEnabled}" Value="True">
                                <Setter Property="Text" Value="Keep Awake: ON"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Button>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusText}"
                   HorizontalAlignment="Center" Margin="0,10,0,0"
                   Foreground="Gray"/>
    </Grid>
</Window>
